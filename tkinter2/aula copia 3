import tkinter as tk
from tkinter import listbox

root = tk.Tk()
root.title("Exemplo de Checkbutton")
root.geometry("3000x150")

def selecao_mudou(evento):
         sel = evento.widget.curselection()
         if sel:
                 idx = sel{0}
                 label.config(
                         text=f"{evento.widget.get(idx)} selecionado!! ")
listbox = tk.listbox(root)
for item in ["primiro", "segundo", "terceiro"]:
        listbox.insert(tk.end, item)
listbox.bind("<<ListboxSelected>>", selecaomudou)
listbox.pack(expand=True)
label = tk.(root, text="primeiro selecionado!!")
label.pack